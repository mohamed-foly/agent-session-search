# Copy this file to .env and adjust for your machine. Nothing in this repo
# should ever hardcode a path, username, or org — everything comes from here.

# --- server ---
PORT=4173
# Where the SQLite search index is stored (created automatically).
INDEX_DB_PATH=./data/index.sqlite3
# How often (seconds) the background indexer re-scans agent session directories.
REINDEX_INTERVAL_SECONDS=120

# --- agents ---
# Comma-separated list of adapter ids to enable. See backend/src/adapters/registry.ts
# for the full list of ids a given build supports.
ENABLED_AGENTS=claude-code,codex

# Claude Code stores one project directory per working-directory under this root,
# each containing "<session-id>.jsonl" transcripts. Default matches Claude Code's
# own default; override if you use CLAUDE_CONFIG_DIR.
CLAUDE_CODE_SESSIONS_DIR=~/.claude/projects

# Codex CLI stores "rollout-*.jsonl" transcripts under YYYY/MM/DD folders below this root.
CODEX_SESSIONS_DIR=~/.codex/sessions

# --- Docker only: display paths ---
# Leave unset when running directly on the host (npm start) — not needed there.
# When running in Docker, *_SESSIONS_DIR above is a container-internal mount
# path; set these to the real host path behind that mount so search results
# show a path you can actually open, instead of the container-internal one.
# docker-compose.yml already sets these for you automatically.
# CLAUDE_CODE_HOST_SESSIONS_DIR=~/.claude/projects
# CODEX_HOST_SESSIONS_DIR=~/.codex/sessions

# --- resume commands ---
# The shell command template used to resume a session, with {sessionId} and {cwd}
# substituted in. Override if your agent CLI is invoked differently (alias, wrapper, etc).
# Optional {args} marks where extra flags go; without it they're appended.
CLAUDE_CODE_RESUME_COMMAND=cd {cwd} && claude --resume {sessionId}
CODEX_RESUME_COMMAND=cd {cwd} && codex resume {sessionId}

# Default extra flags filled into {args}, per agent. Each browser can override
# these in the UI's Settings panel.
# e.g. CLAUDE_CODE_RESUME_ARGS=--dangerously-skip-permissions --teammate-mode in-process
CLAUDE_CODE_RESUME_ARGS=
CODEX_RESUME_ARGS=

# --- Docker only: rebuilding missing sessions ---
# The Claude Code sessions directory is mounted read-only by default. Set to
# "rw" to let the UI's "Rebuild conversation" write recovered transcripts back
# (it only ever creates files that are missing; it never overwrites).
# CLAUDE_CODE_SESSIONS_MOUNT_MODE=rw
